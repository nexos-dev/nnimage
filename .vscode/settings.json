{
    "files.associations": {
        "*.comp": "shellscript",
        "TODO": "plaintext"
    },
    "C_Cpp.default.includePath": [
        "external/include",
        "build",
        "source",
        "/opt/homebrew/include"
    ],
    "C_Cpp.default.cppStandard": "c++23",
    "clang-tidy.lintOnSave": true,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": false,
    "VSCodeCounter.exclude": [
        "**/.gitignore",
        "**/.vscode/**",
        "**/node_modules/**",
        "external/**",
        "build/**"
    ]
}